# Environment configuration for SachetSewa
# Copy this file to .env and adjust values as needed. Do NOT commit .env with real secrets.

ENVIRONMENT=development
DATABASE_URL=postgresql://sachetsewa_user:change_this_password@localhost:5432/sachetsewa_db
JWT_SECRET=change_this_to_a_secure_random_secret_at_least_32_chars
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
ALLOWED_ORIGIN=http://localhost:5173
